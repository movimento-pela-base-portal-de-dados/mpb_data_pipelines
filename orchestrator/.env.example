# Copie para orchestrator/.env e preencha com os valores do SSM Parameter Store.
POSTGRES_USER=prefect
POSTGRES_PASSWORD=
POSTGRES_DB=prefect

# Basic auth da API Prefect, no formato usuario:senha.
PREFECT_AUTH_STRING=

# URL da API vista pelo navegador (padrão: túnel SSM em 127.0.0.1:4200).
PREFECT_UI_API_URL=http://127.0.0.1:4200/api

AWS_REGION=us-east-1
